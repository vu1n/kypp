{
  "name": "kypp-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "sed '/\"ai\":/d' wrangler.jsonc > wrangler.local.jsonc && wrangler dev -c wrangler.local.jsonc",
