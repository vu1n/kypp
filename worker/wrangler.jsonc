{
  "name": "kypp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // No ids: `wrangler deploy` (and the Deploy to Cloudflare button) creates the database and namespace
  // on first deploy and keeps them linked after. An existing deployment stays bound to the ones it has.
  "d1_databases": [
    { "binding": "DB", "database_name": "kypp", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [
    { "binding": "OAUTH_KV" }
  ],
  // KYPP_PUBLIC_URL and KYPP_OIDC_OWNERS are per-install, so they are set on the Worker (dashboard or
  // `wrangler deploy --var`), not here; keep_vars stops a deploy from wiping them.
  "keep_vars": true,
  // The cleanup pass (supersede duplicates, promote two-session claims) runs here, in one place.
  // KYPP_PUBLIC_URL (optional): the public origin, used as the OAuth issuer, the MCP resource id
  // (<url>/mcp) and the OIDC audience. Unset, the Worker uses the origin each request came in on.
  // KYPP_RECUR_GAP_MINUTES: how far apart the sessions behind a promotion must be.
  // KYPP_CORRECT: "off" hides `correct`, which lands accepted claims past the gate and the
  // two-session rule. Off for the alpha; set "on" once agents should be trusted with it.
  // KYPP_OIDC_OWNERS (optional): GitHub owners (comma list, e.g. "vu1n") whose Actions may call
  // /v1/systemone with an OIDC token whose audience is the public origin. Unset refuses OIDC.
  "vars": { "KYPP_RECUR_GAP_MINUTES": "60", "KYPP_CORRECT": "off" },
  // The System One gate runs Clef here when no TYPESAFE_API_KEY is set (KYPP_S1_MODEL picks clef-flash).
  "ai": { "binding": "AI" },
  // Passphrase attempts on the sign-in page: 5 a minute per IP. Client registrations: 3 a minute per IP.
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "REGISTER_LIMIT", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }
  ],
  "triggers": { "crons": ["17 * * * *"] },
  // The owner's install at kypp.vu1n.dev: `npm run deploy:production`. The top level above stays the
  // Deploy to Cloudflare template (no ids, no domain). Bindings and vars are not inherited by an env,
  // so they are repeated here; change one, change both. Ids are identifiers, not credentials; secrets
  // stay on the Worker.
  "env": {
    "production": {
      "name": "kypp",
      "routes": [{ "pattern": "kypp.vu1n.dev", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        { "binding": "DB", "database_name": "kypp", "database_id": "8721aef1-9132-4b9d-8470-3181f044765c", "migrations_dir": "migrations" }
      ],
      "kv_namespaces": [
        { "binding": "OAUTH_KV", "id": "9735fc70e9a14a01bdd88b20c1282c56" }
      ],
      "vars": {
        "KYPP_PUBLIC_URL": "https://kypp.vu1n.dev",
        "KYPP_OIDC_OWNERS": "vu1n",
        "KYPP_ROOM_ISSUERS": "huddles-up",
        "KYPP_RECUR_GAP_MINUTES": "60",
        "KYPP_CORRECT": "off"
      },
      "ai": { "binding": "AI" },
      "ratelimits": [
        { "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
        { "name": "REGISTER_LIMIT", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }
      ]
    }
  }
  // Secrets (wrangler secret put): KYPP_OWNER_SECRET (sign-in passphrase), CONSENT_SECRET (32+ chars),
  // KYPP_API_TOKENS (optional "name:token,name:token" for headless clients such as huddles; the
  // name is the token's user, so "owner:<token>" shares your own user scope; "name@projA|projB:token"
  // pins a token to those projects, see README), KYPP_S1_TOKENS
  // (optional "name:token,..." for /v1/systemone callers outside GitHub Actions; never accepted on /mcp).
  // System One gate: Clef on the AI binding by default. A TYPESAFE_API_KEY secret (plus optional
  // TYPESAFE_BASE_URL / TYPESAFE_DEFAULT_MODEL vars) routes it to TypeSafe instead. KYPP_S1=off disables it;
  // KYPP_RERANK=off keeps the write gate but leaves recall in keyword order (no per-recall model calls).
}
