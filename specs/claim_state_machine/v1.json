        {"actor":"operator","action":"correct","payload":{"claim_id":"a","content":"old"},"head":"a","claims":{"a":["accepted","human","correction"]}},
        {"actor":"operator","action":"correct","payload":{"claim_id":"b","content":"new"},"head":"b","claims":{"a":["superseded","human","correction"],"b":["accepted","human","correction"]}},
