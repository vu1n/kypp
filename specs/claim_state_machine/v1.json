{
  "schema_version": 1,
  "status": "proposed-reference-vectors-not-production-conformance",
  "cases": [
    {
      "name": "agent proposal needs acceptance and operator acceptance does not mint human",
      "steps": [
        {"actor":"agent","action":"propose","payload":{"claim_id":"a","content":"lesson"},"head":null,"claims":{"a":["candidate","agent",null]}},
        {"actor":"agent","action":"accept","payload":{"claim_id":"a"},"error":"forbidden","head":null,"claims":{"a":["candidate","agent",null]}},
        {"actor":"operator","action":"accept","payload":{"claim_id":"a"},"head":"a","claims":{"a":["accepted","agent","explicit"]}}
      ]
    },
    {
      "name": "correction atomically replaces and historical IDs never revive",
      "steps": [
        {"actor":"operator","action":"correct","payload":{"claim_id":"a","content":"old"},"head":"a","claims":{"a":["accepted","human","correction"]}},
        {"actor":"operator","action":"correct","payload":{"claim_id":"b","content":"new"},"head":"b","claims":{"a":["superseded","human","correction"],"b":["accepted","human","correction"]}},
        {"actor":"operator","action":"accept","payload":{"claim_id":"a"},"error":"retired","head":"b","claims":{"a":["superseded","human","correction"],"b":["accepted","human","correction"]}},
        {"actor":"operator","action":"propose","payload":{"claim_id":"a","content":"reuse"},"error":"id_exists","head":"b","claims":{"a":["superseded","human","correction"],"b":["accepted","human","correction"]}}
      ]
    },
    {
      "name": "conflict does not destroy candidates",
      "steps": [
        {"actor":"agent","action":"propose","payload":{"claim_id":"a","content":"port 1","source":"s1"},"head":null,"claims":{"a":["candidate","agent",null]}},
        {"actor":"agent","action":"propose","payload":{"claim_id":"b","content":"port 2","source":"s2"},"head":null,"claims":{"a":["candidate","agent",null],"b":["candidate","agent",null]}},
        {"actor":"maintenance","action":"accept","payload":{"claim_id":"a","reason":"recurrence","support":["a","b"],"agreement":"conflicts"},"error":"agreement_required","head":null,"claims":{"a":["candidate","agent",null],"b":["candidate","agent",null]}}
      ]
    },
    {
      "name": "scheduled check recovery does not change accepted lifecycle",
      "steps": [
        {"actor":"operator","action":"propose","payload":{"claim_id":"a","content":"lesson","verifier":"check"},"head":null,"claims":{"a":["candidate","agent",null]}},
        {"actor":"operator","action":"begin_check","command_id":"first","payload":{"claim_id":"a"},"head":null,"claims":{"a":["candidate","agent",null]}},
        {"actor":"operator","action":"complete_check","payload":{"token_from":"first","outcome":"passed"},"head":"a","claims":{"a":["accepted","verified","verification"]},"usable":{"a":true}},
        {"actor":"operator","action":"begin_check","command_id":"second","payload":{"claim_id":"a"},"head":"a","claims":{"a":["accepted","verified","verification"]},"usable":{"a":true}},
        {"actor":"operator","action":"complete_check","payload":{"token_from":"second","outcome":"failed"},"head":"a","claims":{"a":["accepted","verified","verification"]},"usable":{"a":false}},
        {"actor":"operator","action":"begin_check","command_id":"third","payload":{"claim_id":"a"},"head":"a","claims":{"a":["accepted","verified","verification"]},"usable":{"a":false}},
        {"actor":"operator","action":"complete_check","payload":{"token_from":"third","outcome":"passed"},"head":"a","claims":{"a":["accepted","verified","verification"]},"usable":{"a":true}}
      ]
    },
    {
      "name": "old candidate check cannot replace a newer verified answer",
      "steps": [
        {"actor":"operator","action":"propose","payload":{"claim_id":"a","content":"old","verifier":"check a"},"head":null,"claims":{"a":["candidate","agent",null]}},
        {"actor":"operator","action":"begin_check","command_id":"check-a","payload":{"claim_id":"a"},"head":null,"claims":{"a":["candidate","agent",null]}},
        {"actor":"operator","action":"propose","payload":{"claim_id":"b","content":"new","verifier":"check b"},"head":null,"claims":{"a":["candidate","agent",null],"b":["candidate","agent",null]}},
        {"actor":"operator","action":"begin_check","command_id":"check-b","payload":{"claim_id":"b"},"head":null,"claims":{"a":["candidate","agent",null],"b":["candidate","agent",null]}},
        {"actor":"operator","action":"complete_check","payload":{"token_from":"check-b","outcome":"passed"},"head":"b","claims":{"a":["candidate","agent",null],"b":["accepted","verified","verification"]}},
        {"actor":"operator","action":"complete_check","payload":{"token_from":"check-a","outcome":"passed"},"head":"b","claims":{"a":["candidate","verified",null],"b":["accepted","verified","verification"]},"usable":{"a":false,"b":true}}
      ]
    },
    {
      "name": "superseded human cannot revive through a late check",
      "steps": [
        {"actor":"operator","action":"correct","payload":{"claim_id":"a","content":"old","verifier":"check"},"head":"a","claims":{"a":["accepted","human","correction"]},"usable":{"a":false}},
        {"actor":"operator","action":"begin_check","command_id":"check-old","payload":{"claim_id":"a"},"head":"a","claims":{"a":["accepted","human","correction"]}},
        {"actor":"operator","action":"correct","payload":{"claim_id":"b","content":"new"},"head":"b","claims":{"a":["superseded","human","correction"],"b":["accepted","human","correction"]}},
        {"actor":"operator","action":"complete_check","payload":{"token_from":"check-old","outcome":"passed"},"error":"retired","head":"b","claims":{"a":["superseded","human","correction"],"b":["accepted","human","correction"]}}
      ]
    },
    {
      "name": "another principal relaying one source is not recurrence",
      "steps": [
        {"actor":"agent","action":"propose","payload":{"claim_id":"a","content":"lesson","source":"original"},"head":null,"claims":{"a":["candidate","agent",null]}},
        {"actor":"relay","action":"propose","payload":{"claim_id":"b","content":"lesson","source":"original"},"head":null,"claims":{"a":["candidate","agent",null],"b":["candidate","agent",null]}},
        {"actor":"maintenance","action":"accept","payload":{"claim_id":"a","reason":"recurrence","support":["a","b"],"agreement":"exact"},"error":"insufficient_recurrence","head":null,"claims":{"a":["candidate","agent",null],"b":["candidate","agent",null]}}
      ]
    }
  ]
}
